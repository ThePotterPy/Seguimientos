# Copiar a .env local (ignorado por Git) o configurar en Railway.
# No subir valores reales al repositorio.
ANDREANI_AUTHORIZATION=
ANDREANI_AES_KEY=
ANDREANI_AES_IV=
# Sesión inicial opcional. Las renovaciones verificadas en el archivo privado prevalecen.
ENTREGAR_COOKIE=
# En Railway, usar una ruta de un volumen persistente, por ejemplo /data/entregar-session.json.
# ENTREGAR_SESSION_FILE=/data/entregar-session.json
# PORT=3333
# HOST=127.0.0.1
